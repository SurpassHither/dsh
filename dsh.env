# DSH for TOS runtime parameters
# NOTE: this file is a **template**: postinst rewrites it on install using this
# machine's IPs/hostname, so editing it here does not affect installed
# instances. Change postinst instead, or edit the file after installation.
# Loaded by systemd through EnvironmentFile=-/usr/local/dsh/dsh.env
DSH_HOME=/var/lib/dsh/dsh
DSH_PORT=18142
DSH_TRUSTED_HOSTS="127.0.0.1:8181 127.0.0.1:5443"
