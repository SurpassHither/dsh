# Cross-platform line endings are the #1 rejection cause: force LF
* text=auto eol=lf
*.sh   text eol=lf
*.py   text eol=lf
*.ini  text eol=lf
*.lang text eol=lf
*.env  text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.yml  text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.svg  text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.deb  binary
*.gz   binary
*.bz2  binary
