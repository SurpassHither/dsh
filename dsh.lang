version = "1.7.5"
descript = "DSH for TOS er en uoffisiell TerraMaster-pakke av DeepSeek Harness (DSH), kodeagenten med åpen kildekode som DeepSeek utgir under MIT-lisensen. Den inneholder det originale DSH-grensesnittet og en fast Node.js-runtime, fungerer offline, økter og arbeidsområder ligger på datavolumet, og tjenesten kjører uten privilegier bak TOS' nettrute. Legg inn API-nøkkelen i innstillingene. Uoffisielt produkt, ikke tilknyttet DeepSeek."
release_note = "Retter punktene fra 1.7.3-gjennomgangen: et appspesifikt autentiseringsendepunkt basert på det dokumenterte TOS-API-et erstatter den interne sockelen, gateway-headeren bruker en tilfeldig hemmelighet per installasjon, undici.bak fjernes, og hver medfølgende binær oppgir SHA-256."
important = "Kjører som den upriviligerte kontoen dsh-user. Data ligger i /Volume1/@apps/dsh/data og beholdes ved avinstallering, det gjør også kontoen. Slett alt: sudo SH_DSH_PURGE_DATA=1 dpkg --purge dsh."

[nl-nl]
name = "DSH voor TOS"
auth = "SurpassHither"
version = "1.7.5"
descript = "DSH for TOS is een niet-officieel TerraMaster-pakket van DeepSeek Harness (DSH), de open-source codeeragent die DeepSeek onder de MIT-licentie uitgeeft. Het bevat de originele DSH-interface en een vaste Node.js-runtime, werkt offline, sessies en werkruimten blijven op het datavolume en de dienst draait zonder privileges achter de TOS-webbroute. Voer uw API-sleutel in bij Instellingen. Niet-officieel product, niet verbonden aan DeepSeek."
release_note = "Lost de punten uit de 1.7.3-review op: een authenticatie-endpoint per app op basis van de gedocumenteerde TOS-API vervangt de interne socket, de gateway-header gebruikt een willekeurig geheim per installatie, undici.bak is verwijderd en elke meegeleverde binary vermeldt zijn SHA-256."
important = "Draait als het niet-geprivilegieerde account dsh-user. Gegevens staan in /Volume1/@apps/dsh/data en blijven na verwijderen staan, net als het account. Alles wissen: sudo SH_DSH_PURGE_DATA=1 dpkg --purge dsh."

[sv-se]
name = "DSH för TOS"
auth = "SurpassHither"
version = "1.7.5"
descript = "DSH for TOS är ett inofficiellt TerraMaster-paket av DeepSeek Harness (DSH), kodagenten med öppen källkod som DeepSeek ger ut under MIT-licensen. Det innehåller det ursprungliga DSH-gränssnittet och en fast Node.js-runtime, fungerar offline, sessioner och arbetsytor ligger på datavolymen och tjänsten körs utan privilegier bakom TOS webbväg. Ange din API-nyckel i inställningarna. Icke-officiell produkt, inte knuten till DeepSeek."
release_note = "Åtgärdar punkterna från 1.7.3-granskningen: en appspecifik autentiseringsslutpunkt baserad på det dokumenterade TOS-API:et ersätter den interna sockeln, gateway-rubriken använder en slumpmässig hemlighet per installation, undici.bak tas bort och varje medföljande binär anger sin SHA-256."
important = "Körs som det opriviligierade kontot dsh-user. Data ligger i /Volume1/@apps/dsh/data och finns kvar efter avinstallation, liksom kontot. Radera allt: sudo SH_DSH_PURGE_DATA=1 dpkg --purge dsh."

[th-th]
name = "DSH สำหรับ TOS"
auth = "SurpassHither"
version = "1.7.5"
descript = "DSH for TOS เป็นแพ็กเกจ TerraMaster ที่ไม่เป็นทางการของ DeepSeek Harness (DSH) เอเจนต์เขียนโค้ดโอเพนซอร์สที่ DeepSeek พัฒนาภายใต้สัญญา MIT มาพร้อมอินเทอร์เฟซ DSH ดั้งเดิมและรันไทม์ Node.js เวอร์ชันคงที่ ใช้งานออฟไลน์ได้ เซสชันและเวิร์กสเปซเก็บไว้บนไดรฟ์ข้อมูล บริการทำงานด้วยบัญชีไม่มีสิทธิพิเศษผ่านเส้นทางเว็บของ TOS ใส่คีย์ API ของคุณในการตั้งค่า ไม่ใช่ผลิตภัณฑ์อย่างเป็นทางการของ DeepSeek และไม่มีความเกี่ยวข้องกับ DeepSeek"
release_note = "แก้ไขข้อตรวจสอบ 1.7.3: ใช้ endpoint ยืนยันตัวตนต่อแอปที่อิง TOS API ที่เผยแพร่แทนซ็อกเก็ตภายใน ส่วนหัวเกตเวย์ใช้รหัสสุ่มต่อการติดตั้ง ลบ undici.bak และระบุ SHA-256 ของไบนารีที่มาพร้อมแพ็กเกจ"
important = "รันด้วยบัญชี dsh-user ที่ไม่ใช่ root ข้อมูลอยู่ที่ /Volume1/@apps/dsh/data และคงอยู่หลังถอนการติดตั้ง รวมถึงบัญชี ลบทั้งหมดด้วย sudo SH_DSH_PURGE_DATA=1 dpkg --purge dsh"

[vi-vn]
name = "DSH cho TOS"
auth = "SurpassHither"
version = "1.7.5"
descript = "DSH for TOS là gói TerraMaster không chính thức của DeepSeek Harness (DSH), công cụ lập trình mã nguồn mở do DeepSeek phát hành theo giấy phép MIT. Gói bao gồm giao diện DSH gốc và Node.js phiên bản cố định, hoạt động ngoại tuyến, phiên và không gian làm việc lưu trên ổ dữ liệu, dịch vụ chạy không đặc quyền sau tuyến web TOS. Nhập khóa API của bạn trong Cài đặt. Không phải sản phẩm chính thức của DeepSeek và không liên kết với DeepSeek."
release_note = "Khắc phục các mục đánh giá 1.7.3: endpoint xác thực riêng cho ứng dụng dựa trên API TOS đã công bố thay cho socket nội bộ, tiêu đề cổng dùng bí mật ngẫu nhiên mỗi lần cài, đã xóa undici.bak và mỗi tệp nhị phân kèm SHA-256."
important = "Chạy bằng tài khoản dsh-user không có quyền root. Dữ liệu ở /Volume1/@apps/dsh/data và vẫn còn sau khi gỡ cài đặt, kể cả tài khoản. Xóa tất cả: sudo SH_DSH_PURGE_DATA=1 dpkg --purge dsh."
