important = "非 root の dsh-user アカウントで動作します。データは /Volume1/@apps/dsh/data にあり、アンインストール後もアカウントごと残ります。完全削除は sudo SH_DSH_PURGE_DATA=1 dpkg --purge dsh を実行してください。"

[ko-kr]
name = "DSH (TOS 버전)"
auth = "SurpassHither"
version = "1.7.5"
descript = "DSH for TOS는 DeepSeek이 MIT 라이선스로 공개한 오픈소스 코딩 에이전트 DeepSeek Harness(DSH)의 비공식 TerraMaster 패키지입니다. 원본 DSH 웹 UI와 고정 버전 Node.js를 포함하며 오프라인으로 동작합니다. 세션과 워크스페이스는 데이터 볼륨에 저장되고, 서비스는 비root 계정으로 TOS 웹 경로 뒤에서 실행됩니다. 설정에서 API 키를 입력하세요. DeepSeek 공식 제품이 아니며 DeepSeek과 무관합니다."
release_note = "1.7.3 검토 지적을 수정했습니다. 문서화된 TOS API 기반의 앱별 인증 엔드포인트가 내부 소켓을 대체하고, 게이트 헤더는 설치마다 무작위 비밀값을 사용하며, undici.bak을 제거하고 포함된 바이너리의 SHA-256을 명시했습니다."
important = "비 root dsh-user 계정으로 실행됩니다. 데이터는 /Volume1/@apps/dsh/data에 있으며 제거 후에도 계정과 함께 유지됩니다. 모두 삭제하려면 sudo SH_DSH_PURGE_DATA=1 dpkg --purge dsh를 실행하세요."

[pl-pl]
