[hu-hu]
name = "DSH TOS-hoz"
auth = "SurpassHither"
version = "1.7.5"
descript = "A DSH for TOS a DeepSeek Harness (DSH) nem hivatalos TerraMaster-csomagja, a DSH a DeepSeek MIT licencű nyílt forráskódú kódoló ügynöke. Az eredeti DSH felületet és rögzített Node.js futtatókörnyezetet tartalmazza, offline működik, a munkamenetek és munkaterületek az adatköteten maradnak, a szolgáltatás jogosultság nélkül fut a TOS webes útvonala mögött. Az API-kulcsot a beállításokban add meg. Nem hivatalos termék, nem áll kapcsolatban a DeepSeekkel."
release_note = "Az 1.7.3-as ellenőrzés pontjait javítja: a dokumentált TOS API-ra épülő alkalmazásonkénti hitelesítési végpont váltja a belső socketet, az átjáró fejléc telepítésenkénti véletlen titkot használ, az undici.bak törölve, és minden mellékelt bináris SHA-256-ot kap."
important = "Nem root dsh-user fiókkal fut. Az adatok a /Volume1/@apps/dsh/data helyen maradnak eltávolításkor, a fiók is. Teljes törlés: sudo SH_DSH_PURGE_DATA=1 dpkg --purge dsh."

[ja-jp]
